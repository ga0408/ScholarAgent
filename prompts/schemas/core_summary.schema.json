{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["introduction", "related_works", "method", "experiments", "conclusion"],
  "properties": {
    "introduction": {
      "type": "object",
      "required": ["problem", "prior_limitations", "motivation", "key_differences", "contributions"],
      "properties": {
        "problem": { "type": "string" },
        "prior_limitations": { "type": "string" },
        "motivation": { "type": "string" },
        "key_differences": { "type": "array", "items": { "type": "string" } },
        "contributions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "related_works": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "comparison_summary", "methods"],
        "properties": {
          "category": { "type": "string" },
          "comparison_summary": { "type": "string" },
          "methods": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "summary", "limitation_vs_ours", "needs_triage"],
              "properties": {
                "name": { "type": "string" },
                "arxiv_hint": { "type": "string" },
                "summary": { "type": "string" },
                "limitation_vs_ours": { "type": "string" },
                "needs_triage": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "method": {
      "type": "object",
      "required": ["overview", "differences_from_prior", "equations", "target_pages"],
      "properties": {
        "overview": { "type": "string" },
        "differences_from_prior": { "type": "string" },
        "equations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["latex", "meaning"],
            "properties": {
              "latex": { "type": "string" },
              "meaning": { "type": "string" }
            }
          }
        },
        "target_pages": { "type": "array", "items": { "type": "integer" } }
      }
    },
    "experiments": {
      "type": "object",
      "required": ["benchmarks", "setup", "quantitative_comparisons", "results_comparison", "target_pages"],
      "properties": {
        "benchmarks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description", "needs_lookup"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "needs_lookup": { "type": "boolean" }
            }
          }
        },
        "setup": { "type": "string" },
        "quantitative_comparisons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["benchmark_or_task", "metric", "ours", "strongest_baseline", "delta_or_note", "source_ref"],
            "properties": {
              "benchmark_or_task": { "type": "string" },
              "metric": { "type": "string" },
              "ours": { "type": "string" },
              "strongest_baseline": { "type": "string" },
              "delta_or_note": { "type": "string" },
              "source_ref": { "type": "string" }
            }
          }
        },
        "results_comparison": { "type": "string" },
        "target_pages": { "type": "array", "items": { "type": "integer" } }
      }
    },
    "conclusion": {
      "type": "object",
      "required": ["closing_summary", "limitations"],
      "properties": {
        "closing_summary": { "type": "string" },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
