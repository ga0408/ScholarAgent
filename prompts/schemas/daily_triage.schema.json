{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["paper_id", "problem_ko", "method_ko", "result_ko", "caveat_ko", "summary_ko", "why_read", "relevance_score", "tags"],
        "properties": {
          "paper_id": { "type": "string" },
          "problem_ko": { "type": "string" },
          "method_ko": { "type": "string" },
          "result_ko": { "type": "string" },
          "caveat_ko": { "type": "string" },
          "summary_ko": { "type": "string" },
          "why_read": { "type": "string" },
          "relevance_score": { "type": "integer", "minimum": 1, "maximum": 5 },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
