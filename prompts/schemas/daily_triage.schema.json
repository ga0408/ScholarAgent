{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["paper_id", "summary_ko", "why_read", "tags"],
        "properties": {
          "paper_id": { "type": "string" },
          "summary_ko": { "type": "string" },
          "why_read": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
