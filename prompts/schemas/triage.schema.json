{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["overview", "background", "problem", "motivation", "contributions", "domain_tags", "key_pages"],
  "properties": {
    "overview": { "type": "string" },
    "background": { "type": "string" },
    "problem": { "type": "string" },
    "motivation": { "type": "string" },
    "contributions": { "type": "array", "items": { "type": "string" } },
    "domain_tags": { "type": "array", "items": { "type": "string" } },
    "key_pages": {
      "type": "object",
      "properties": {
        "method_pages": { "type": "array", "items": { "type": "integer" } },
        "experiment_pages": { "type": "array", "items": { "type": "integer" } }
      }
    }
  }
}
