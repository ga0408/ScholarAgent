{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["tldr", "overview", "domain_tags", "needs_intro_peek", "needs_method_peek", "key_pages"],
  "properties": {
    "tldr": { "type": "string" },
    "overview": { "type": "string" },
    "domain_tags": { "type": "array", "items": { "type": "string" } },
    "needs_intro_peek": { "type": "boolean" },
    "needs_method_peek": { "type": "boolean" },
    "key_pages": {
      "type": "object",
      "properties": {
        "intro_pages": { "type": "array", "items": { "type": "integer" } },
        "related_work_pages": { "type": "array", "items": { "type": "integer" } },
        "method_pages": { "type": "array", "items": { "type": "integer" } },
        "experiment_pages": { "type": "array", "items": { "type": "integer" } },
        "conclusion_pages": { "type": "array", "items": { "type": "integer" } }
      }
    }
  }
}
