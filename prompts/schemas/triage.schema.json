{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["tldr", "overview", "core_problem", "core_mechanism", "headline_result", "domain_tags", "key_pages"],
  "properties": {
    "tldr": { "type": "string" },
    "overview": { "type": "string" },
    "core_problem": { "type": "string" },
    "core_mechanism": { "type": "string" },
    "headline_result": { "type": "string" },
    "domain_tags": { "type": "array", "items": { "type": "string" } },
    "key_pages": {
      "type": "object",
      "required": ["intro_pages", "related_work_pages", "method_pages", "experiment_pages", "conclusion_pages"],
      "properties": {
        "intro_pages": { "type": "array", "items": { "type": "integer" } },
        "related_work_pages": { "type": "array", "items": { "type": "integer" } },
        "method_pages": { "type": "array", "items": { "type": "integer" } },
        "experiment_pages": { "type": "array", "items": { "type": "integer" } },
        "conclusion_pages": { "type": "array", "items": { "type": "integer" } }
      }
    }
  }
}
